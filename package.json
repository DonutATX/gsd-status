{
  "name": "gsd-status",
  "displayName": "GSD Status",
  "description": "Live GSD workflow state — milestone, phase, and recent activity — in your VS Code status bar.",
  "version": "0.1.0",
  "publisher": "donutatx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DonutATX/gsd-extenstion"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {},
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Read-only display of GSD planning files."
    },
    "virtualWorkspaces": true
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && mocha \"out/test/parsers/**/*.test.js\"",
    "test:parsers": "mocha \"out/test/parsers/**/*.test.js\"",
    "package:vsix": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^11.7.5",
    "typescript": "^5.8"
  }
}
